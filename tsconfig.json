{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome", "vite/client", "node"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vitest.config.ts"]
}
